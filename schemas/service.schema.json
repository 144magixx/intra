{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://intra.invalid/schemas/service.schema.json",
  "title": "service.schema.json",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "baseUrl": {
      "type": "string",
      "pattern": "^https?://"
    },
    "allowedOrigins": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^https?://"
      }
    },
    "auth": {
      "type": "object",
      "properties": {
        "cookieNames": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[!#$%&'*+.^_`|~0-9A-Za-z-]{1,256}(?![\\s\\S])"
          }
        },
        "identityProbeOperation": {
          "type": "string"
        },
        "authFailureRules": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "kind": {
                "enum": [
                  "loginRedirect",
                  "businessCode",
                  "probeFailure"
                ]
              },
              "origin": {
                "type": "string"
              },
              "pathPrefix": {
                "type": "string"
              },
              "pointer": {
                "type": "string",
                "pattern": "^(|/.*)$"
              },
              "equals": {}
            },
            "required": [
              "kind"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "protocolExceptions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "origin": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "origin",
          "reason"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "baseUrl",
    "allowedOrigins",
    "auth"
  ],
  "additionalProperties": false
}
